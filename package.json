{
  "name": "@udus/fdl-js",
  "version": "0.1.0",
  "description": "Read DuckLake tables published as FDL repositories, without DuckDB: resolve refs, list a version's files and read Parquet by range",
  "keywords": [
    "cloudflare-workers",
    "ducklake",
    "fdl",
    "hyparquet",
    "parquet"
  ],
  "homepage": "https://github.com/queria-io/fdl-js#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/queria-io/fdl-js.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "oxlint && oxfmt --check .",
    "fix": "oxlint --fix && oxfmt ."
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "hyparquet": "^1.32.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@types/node": "^22.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.7.4",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.17.1"
}
